# cp .env.example .env  — part of startup (§15). .env is gitignored and stays that way.
#
# The credentials below are local-development placeholders. Change them before this
# stack is reachable from anywhere but this machine.

# --- credentials -------------------------------------------------------------------
POSTGRES_USER=hcs
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=hcs

MINIO_ROOT_USER=hcs-minio
MINIO_ROOT_PASSWORD=change-me-locally-too

GRAFANA_PASSWORD=change-me-as-well

# --- host ports --------------------------------------------------------------------
# Defaults avoid 80, 3000, 5000, 5432 and 6379, which are in use on this machine. If a
# port collides, change it here rather than in docker-compose.yml.
HTTP_PORT=8080                 # Traefik: the only way into the API
TRAEFIK_DASHBOARD_PORT=8081
POSTGRES_HOST_PORT=15432       # for psql from the host; containers use postgres:5432
REDIS_HOST_PORT=16379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FLOWER_PORT=5555
MLFLOW_PORT=5001

# --- scale and memory (§15) ---------------------------------------------------------
# Development: 2 workers x 1.5 GB. Benchmark raises WORKER_REPLICAS to 4 and measures
# where it breaks. These limits are what makes an OOMKill possible, and an OOMKill is
# how a wrong chunked read announces itself.
API_REPLICAS=2
WORKER_REPLICAS=2

API_MEMORY=512m
WORKER_MEMORY=1536m
POSTGRES_MEMORY=512m
REDIS_MEMORY=640m
MINIO_MEMORY=768m
TRAEFIK_MEMORY=128m
PROMETHEUS_MEMORY=512m
GRAFANA_MEMORY=256m
FLOWER_MEMORY=256m
MLFLOW_MEMORY=512m

# --- buckets and processing ----------------------------------------------------------
BUCKET_RAW=raw
BUCKET_RESULTS=results

CHUNK_SIZE=1024
CHUNK_OVERLAP=32               # must exceed the diameter of the largest expected cell

LOG_LEVEL=INFO

# --- host-side tooling ----------------------------------------------------------------
# Used by alembic, pytest and the seed scripts when run outside a container. Points at
# the published ports above, not at the compose network.
DATABASE_URL=postgresql+psycopg://hcs:change-me-locally@localhost:15432/hcs
REDIS_URL=redis://localhost:16379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=hcs-minio
S3_SECRET_KEY=change-me-locally-too
